#!/bin/bash

# Starts the weather station display: the web server, then the full-screen browser,
# and keeps the browser running.
# captd0nuts 21NOV2023
#
# 2026-09-18 (1): instead of fixed sleeps this waits for what it actually needs --
# the server, the desktop, and network + a correct clock -- so the display appears
# about as soon as it can. Every wait has a time limit, and if one runs out the
# browser is launched anyway (the app retries on its own schedule), so a slow router
# after a power cut can never leave the screen blank.
# 2026-09-18 (2): the browser now runs in a loop. If it exits or crashes it is
# started again (after checking the server is still up); the nightly 04:00 cron job
# just closes the browser and this loop opens a fresh one. Before this, a browser
# crash left the desktop showing until someone rebooted.
# 2026-09-19: a background health check restarts the server if it stops answering
# while the browser is open (3 misses in a row, checked once a minute).
# Progress is logged with time-since-boot to ~/start-weather.log (via cron).
#
# Test switches (normally unset):  DRY_RUN=1  -> don't launch the browser
#                                  KIOSK_CMD=... -> run this instead of the browser
#                                  NET_PROBE_URL / WAIT_NET_SECONDS -> override network check
#                                  HEALTH_INTERVAL / HEALTH_FAILS -> seconds between server checks / misses before restart

log() { echo "[$(date '+%H:%M:%S') up $(cut -d. -f1 /proc/uptime)s] $*"; }

# wait_for <max seconds> <command...>  -- retry once a second until it succeeds or time runs out
wait_for() {
  local end=$((SECONDS + $1))
  shift
  until "$@"; do
    [ "$SECONDS" -ge "$end" ] && return 1
    sleep 1
  done
}

server_up()  { curl -s -o /dev/null -m 2 http://localhost:8080/; }
desktop_up() { [ -S /run/user/1000/wayland-1 ] && pgrep -x wf-panel-pi > /dev/null; }
# clock synced (HTTPS fails with a wrong clock) AND a real HTTPS answer from the internet
net_up() {
  [ "$(timedatectl show -p NTPSynchronized --value 2> /dev/null)" = yes ] &&
    curl -s -o /dev/null -m 5 "${NET_PROBE_URL:-https://api.rainviewer.com/public/weather-maps.json}"
}
start_server() {
  log "starting server"
  (cd "$HOME/pi-weather-station/" && /usr/bin/npm start &)
}

cd "$HOME/pi-weather-station/" || { log "ERROR: pi-weather-station folder missing"; exit 1; }

if server_up; then
  log "server already running"
else
  start_server
fi

wait_for 60 server_up && log "server ready" || log "WARNING: server not answering after 60 s"
wait_for 120 desktop_up && log "desktop ready" || log "WARNING: desktop not ready after 120 s, launching anyway"
wait_for "${WAIT_NET_SECONDS:-300}" net_up && log "network + clock ready" || log "WARNING: network/clock not ready, launching anyway"
sleep 2 # let the desktop settle

if [ -n "$DRY_RUN" ]; then
  log "DRY RUN: would launch the kiosk browser now"
  exit 0
fi

# Native Wayland (not Xwayland): the X11 path left a 16 px wallpaper strip at the bottom
export DISPLAY=:0 XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-1 MOZ_ENABLE_WAYLAND=1
KIOSK_CMD="${KIOSK_CMD:-/usr/bin/firefox-esr --kiosk localhost:8080}"

# Health check, in the background: while the browser is open nothing else would notice the server dying
# (the check above only runs when the browser exits). Once a minute, if the server has not answered 3 times
# in a row, restart it. The open browser page keeps running and reloads its data on its own.
health_loop() {
  local fails=0
  while true; do
    sleep "${HEALTH_INTERVAL:-60}"
    if server_up; then
      fails=0
      continue
    fi
    fails=$((fails + 1))
    log "health check: server not answering ($fails/${HEALTH_FAILS:-3})"
    if [ "$fails" -ge "${HEALTH_FAILS:-3}" ]; then
      log "health check: restarting the server"
      pkill -f "[n]ode ./server/index.js"
      sleep 2
      start_server
      wait_for 60 server_up && log "health check: server is back" || log "WARNING: server still not answering after restart"
      fails=0
    fi
  done
}
health_loop &
HEALTH_PID=$!
# stop the health check together with this script, however it is stopped
trap 'kill "$HEALTH_PID" 2> /dev/null' EXIT
trap 'exit 143' TERM INT HUP

while true; do
  if ! server_up; then
    log "server not answering - starting it again"
    start_server
    wait_for 60 server_up || log "WARNING: server still not answering, launching browser anyway"
  fi
  log "launching kiosk browser"
  started=$SECONDS
  # run it in the background and wait, so a stop signal reaches the trap above at once (bash holds a trap
  # back while a foreground program runs)
  $KIOSK_CMD &
  wait $!
  code=$?
  ran=$((SECONDS - started))
  log "kiosk browser exited (code $code) after ${ran}s"
  if [ "$ran" -lt 20 ]; then
    log "exited quickly - waiting 30 s before trying again"
    sleep 30
  else
    sleep 5
  fi
done
